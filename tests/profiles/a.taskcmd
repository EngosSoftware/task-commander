        .HELLO Witaj

.profile german
    .note Full German version
    .vars
        .HELLO Hallo
            .note Means Hello
        .WORLD Welt
            .note Means World

.tasks
    .greeting
        .cmd echo {{HELLO}} {{WORLD}}!
